# =============================================================================
# dcc-canon-rag — environment configuration
# =============================================================================
# Copy to `.env` and fill in real values.

# Path to the dcc training_data_truth/ root. Contains canon/, world_spine/,
# facility_ai/. On Spark #2 this is inside the sparse dcc checkout.
CANON_TRUTH_ROOT=/mnt/c/dev/dcc/SPARK/training_data_truth

# Where the Chroma index lives. Runtime state — kept out of the repo.
INDEX_DIR=/var/lib/dcc-canon-rag/chroma_db

# Server port. Default 3001.
PORT=3001
